<UserControl x:Class="Yappest.Pages.SoundboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Yappest.UI"
             AllowDrop="True" Drop="Page_Drop" DragOver="Page_DragOver">
    <UserControl.Resources>
        <ui:PathToImageConverter x:Key="PathToImage"/>
        <ui:NullToCollapsedConverter x:Key="Vis"/>
        <ui:DurationConverter x:Key="Dur"/>

        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="132" Height="150" CornerRadius="14" Background="{StaticResource Bg2}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1.5" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="68" Height="68" CornerRadius="14" Margin="0,16,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                        Background="{StaticResource Bg4}">
                                    <Border.Clip><RectangleGeometry Rect="0,0,68,68" RadiusX="14" RadiusY="14"/></Border.Clip>
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" Style="{StaticResource Glyph}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDim}"
                                                   Visibility="{Binding Icon, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                        <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding Icon, Converter={StaticResource Vis}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="10,0,10,12">
                                    <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource Dur}}" TextAlignment="Center" Style="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bg4}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding FileMissing}" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Playing}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,4,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                <StackPanel x:Name="Chips" Orientation="Horizontal"/>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Stop all" Click="StopAll_Click" Margin="0,0,6,0"/>
                <Button x:Name="BoardMenuBtn" Style="{StaticResource IconButton}" Content="&#xE712;" Click="BoardMenu_Click" ToolTip="Rename or delete this board" Margin="0,0,10,0"/>
                <Button Style="{StaticResource AccentButton}" Click="AddSound_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource AccentFgBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Add sounds" Foreground="{DynamicResource AccentFgBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <Grid>
                <ItemsControl x:Name="Tiles">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Tile}" Click="Tile_Click" Tag="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit…" Click="Edit_Click"/>
                                        <MenuItem Header="Remove" Click="Remove_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{StaticResource TextFaint}"/>
                    <TextBlock Text="Nothing here yet" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop mp3, wav, ogg or mp4 files anywhere on this page." Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="Busy" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed">
            <TextBlock x:Name="BusyText" Text="Adding…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
        </Border>
    </Grid>
</UserControl>

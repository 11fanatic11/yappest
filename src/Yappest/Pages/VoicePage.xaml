<UserControl x:Class="Yappest.Pages.VoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RoundMute" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
                            <Ellipse x:Name="Fill" Margin="5" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,4,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ============ voice changer list ============ -->
            <Border Style="{StaticResource Panel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="22,18,22,14">
                        <StackPanel>
                            <TextBlock Text="Voice changer" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Text="Pick a voice. It applies to everything people hear from Yappest Input." Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="VcSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="Vc_Changed" Unchecked="Vc_Changed"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,14,16">
                        <StackPanel x:Name="FxList"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============ mic panel ============ -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Microphone" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                        <TextBlock x:Name="MicName" Style="{StaticResource Dim}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Text="IN" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                        <Border Height="10" CornerRadius="5" Background="{StaticResource Bg3}" ClipToBounds="True">
                            <Border x:Name="InFill" HorizontalAlignment="Left" Width="0" Background="{StaticResource TextDim}" CornerRadius="5"/>
                        </Border>
                        <TextBlock Text="OUT  (what Yappest Input hears)" Style="{StaticResource SectionTitle}" Margin="0,14,0,6"/>
                        <Border Height="10" CornerRadius="5" Background="{StaticResource Bg3}" ClipToBounds="True">
                            <Border x:Name="OutFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentBrush}" CornerRadius="5"/>
                        </Border>

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="Mic volume" Style="{StaticResource Dim}"/>
                            <TextBlock x:Name="MicVolValue" HorizontalAlignment="Right" FontFamily="Consolas"/>
                        </Grid>
                        <Slider x:Name="MicVol" Minimum="0" Maximum="2" Margin="0,8,0,0" ValueChanged="MicVol_Changed"/>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,16"/>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Hear myself" FontWeight="SemiBold"/>
                                <TextBlock Text="Play your processed mic in your headphones." Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="190" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox x:Name="HearSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Hear_Changed" Unchecked="Hear_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="In Discord, a game or OBS" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                        <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                   Text="Choose Yappest Input as your microphone. It carries your voice, voice changer and soundboard in one input."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============ round mute button ============ -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="MuteCircle" Style="{StaticResource RoundMute}" Click="MuteCircle_Click" ToolTip="Mute or unmute your microphone">
                <TextBlock x:Name="MuteCircleGlyph" Style="{StaticResource Glyph}" FontSize="28" Text="&#xE720;"/>
            </Button>
            <TextBlock x:Name="MuteCircleText" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" Style="{StaticResource Dim}"/>
        </StackPanel>
    </Grid>
</UserControl>

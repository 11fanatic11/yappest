<Window x:Class="Yappest.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yappest update" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg1}" Icon="pack://application:,,,/Assets/yappest.ico" ShowInTaskbar="True">
    <StackPanel Margin="28,26,28,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentBrush}">
                <Border.Clip><RectangleGeometry Rect="0,0,48,48" RadiusX="12" RadiusY="12"/></Border.Clip>
                <Image Source="pack://application:,,,/Assets/yappest.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock x:Name="Sub" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="WHAT'S NEW" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
        <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" MaxHeight="180">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Notes" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
            <Border Height="6" CornerRadius="3" Background="{StaticResource Bg3}" ClipToBounds="True">
                <Border x:Name="Bar" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
            </Border>
            <TextBlock x:Name="Status" Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Margin="0,24,0,0">
            <Button x:Name="SkipBtn" Content="Skip this version" Click="Skip_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterBtn" Content="Not now" Click="Later_Click" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="UpdateBtn" Content="Update now" Click="Update_Click" Style="{StaticResource AccentButton}" MinWidth="120" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>

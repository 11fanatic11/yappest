<Window x:Class="Yappest.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Yappest" Width="760" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" Icon="pack://application:,,,/Assets/yappest.ico">
    <Grid Margin="48,40,48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <!-- 0 welcome -->
            <StackPanel x:Name="S0" VerticalAlignment="Center">
                <Border Width="84" Height="84" CornerRadius="20" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}">
                    <Border.Clip><RectangleGeometry Rect="0,0,84,84" RadiusX="20" RadiusY="20"/></Border.Clip>
                    <Image Source="pack://application:,,,/Assets/yappest.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Welcome to Yappest" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,26,0,0"/>
                <TextBlock Style="{StaticResource Dim}" FontSize="15" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="560"
                           Text="A free voice changer, soundboard and clipper. It takes about a minute: pick your mic and headphones, set up the virtual microphone, and you're done."/>
            </StackPanel>

            <!-- 1 devices -->
            <StackPanel x:Name="S1" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Your audio" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock Text="Pick the microphone you talk into and where you want to hear sounds, clip effects and yourself." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,26"/>
                <TextBlock Text="MICROPHONE" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <ComboBox x:Name="MicBox"/>
                <TextBlock Text="PLAYBACK (headphones or speakers)" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
                <ComboBox x:Name="OutBox"/>
            </StackPanel>

            <!-- 2 cable -->
            <StackPanel x:Name="S2" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Yappest Input" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,24" MaxWidth="580"
                           Text="Yappest creates a virtual microphone called Yappest Input. It carries your voice, voice changer and soundboard together, so Discord, games and OBS only need that one input."/>
                <Border Style="{StaticResource Panel}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="CableDot" Width="9" Height="9" Margin="0,1,9,0"/>
                                <TextBlock x:Name="CableTitle" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="CableDetail" Style="{StaticResource Dim}" FontSize="12" Margin="18,3,16,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="CableBtn" Grid.Column="1" Style="{StaticResource AccentButton}" Click="Cable_Click" MinWidth="120"/>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="580"
                           Text="Installing the driver needs administrator permission. Windows will show its own prompt and you stay in control. You can also do this later from Settings."/>
            </StackPanel>

            <!-- 3 voicemod -->
            <StackPanel x:Name="S3" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Coming from Voicemod?" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock x:Name="VmText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,24" MaxWidth="580"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="VmBtn" Content="Import my sounds" Style="{StaticResource AccentButton}" Click="Vm_Click" Padding="18,10"/>
                    <TextBlock x:Name="VmDone" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource Dim}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,22,0,0" MaxWidth="580"
                           Text="No Voicemod login is needed. Yappest only copies files Voicemod already saved on this PC and never changes your Voicemod install."/>
            </StackPanel>

            <!-- 4 model -->
            <StackPanel x:Name="S4" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Clip transcripts" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,24" MaxWidth="580"
                           Text="Clips are turned into text so you can trim by clicking words. That uses a small speech model that runs entirely on this PC. It's a one-time download."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ModelBtn" Style="{StaticResource AccentButton}" Click="Model_Click" Padding="18,10"/>
                    <TextBlock x:Name="ModelText" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource Dim}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,22,0,0" Text="Skip it and clips still work. You can download the model later in Settings."/>
            </StackPanel>

            <!-- 5 done -->
            <StackPanel x:Name="S5" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="You're set" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                <TextBlock x:Name="DoneText" Style="{StaticResource Dim}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,26" MaxWidth="580"/>
                <Border Style="{StaticResource Panel}" Padding="20,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold"/>
                            <TextBlock Text="Runs quietly in the tray, so shortcuts and Stream Deck always work." Style="{StaticResource Dim}" FontSize="12" Margin="0,2,16,0"/>
                        </StackPanel>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackBtn" Content="Back" Click="Back_Click" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                <Button x:Name="NextBtn" Content="Next" Click="Next_Click" Style="{StaticResource AccentButton}" MinWidth="110" Padding="18,10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

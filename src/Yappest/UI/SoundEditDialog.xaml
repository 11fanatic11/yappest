<Window x:Class="Yappest.UI.SoundEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg1}" ShowInTaskbar="False" Title="Edit sound">
    <StackPanel Margin="28,26,28,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="92" Height="92" CornerRadius="18" Background="{StaticResource Bg3}">
                <Border.Clip><RectangleGeometry Rect="0,0,92,92" RadiusX="18" RadiusY="18"/></Border.Clip>
                <Grid>
                    <TextBlock x:Name="Initial" Style="{StaticResource Glyph}" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                    <Image x:Name="IconImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Icon" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose image…" Click="ChooseIcon_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RemoveIconBtn" Content="Remove" Click="RemoveIcon_Click" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock Text="png, jpg, webp, gif, bmp" Style="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Name" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
        <TextBox x:Name="NameBox"/>

        <Grid Margin="0,20,0,0">
            <TextBlock Text="Volume" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="VolText" HorizontalAlignment="Right" FontFamily="Consolas"/>
        </Grid>
        <Slider x:Name="VolSlider" Minimum="0" Maximum="2" Margin="0,8,0,0" ValueChanged="Vol_Changed"/>

        <TextBlock Text="Board" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
        <ComboBox x:Name="BoardBox" DisplayMemberPath="Name"/>

        <Grid Margin="0,26,0,0">
            <Button Content="Preview" Click="Preview_Click" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource GhostButton}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" MinWidth="90" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
